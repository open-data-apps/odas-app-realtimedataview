{
  "$schema": "https://frictionlessdata.io/schemas/table-schema.json",
  "name": "odas-app-realtimedataview",
  "title": "Realtimedataview",
  "fields": [
    {
      "name": "date",
      "title": "Zeitpunkt",
      "type": "datetime",
      "description": "Messzeitpunkt im ISO-8601-Format.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "value",
      "title": "Messwert",
      "type": "number",
      "description": "Gemessener Wert zum Zeitpunkt.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "category",
      "title": "Kategorie",
      "type": "any",
      "description": "Optionale Kategorie des Messwerts (beliebiger Inhalt zulässig).",
      "constraints": {
        "required": false
      }
    }
  ]
}
